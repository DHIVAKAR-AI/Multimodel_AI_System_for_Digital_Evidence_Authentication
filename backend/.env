# 1. Google Gemini API Key for Multimodal OCR
# Replace 'YOUR_GEMINI_API_KEY_HERE' below with your actual API key.
# Get your API key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AQ.Ab8RN6KFaMwTKalk_gb-rcs_dErc8kBG2SmL27ZH66vzikwS9w

# 2. Gemini Model for OCR extraction
# Recommended options:
# - gemini-3.5-flash (recommended: high quota, fast multimodal vision & OCR)
# - gemini-3.5-flash-lite (ultra fast, high throughput)
# - gemini-3.8-flash (requires paid or refreshed daily free quota)
GEMINI_MODEL=gemini-3.5-flash

# 3. (Optional) Local Tesseract OCR Executable Path (offline fallback)
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
