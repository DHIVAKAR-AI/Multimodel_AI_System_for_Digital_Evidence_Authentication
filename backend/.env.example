# ========================================================
# VERIDEX Multimodal Forensics - Backend Configuration Template
# ========================================================

# 1. Google Gemini API Key for Multimodal OCR
# Get your API key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# 2. Gemini Model for OCR extraction
# Recommended options:
# - gemini-2.5-flash (default: ultra fast, multimodal vision & OCR)
# - gemini-2.0-flash
# - gemini-1.5-flash
GEMINI_MODEL=gemini-2.5-flash

# 3. (Optional) Local Tesseract OCR Executable Path (offline fallback)
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
